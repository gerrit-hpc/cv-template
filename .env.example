# Required. Postgres URL in production, file URL for SQLite in dev.
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# Optional. Absolute path to your existing cv-template repo, used by the Settings importer button.
KB_SOURCE_REPO_PATH=

# Optional. Set to enable password gate. Generate with `npm run hash-password`.
ADMIN_PASSWORD_HASH=

# Required if ADMIN_PASSWORD_HASH is set. At least 32 chars. Used to sign session cookies.
SESSION_SECRET=

# Required. LLM provider for the chat feature. One of: anthropic, pi
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. Your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional. Anthropic model ID. Defaults to claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=

# Required when LLM_PROVIDER=pi. Your Pi API key (used by @earendil-works/pi-agent-core).
PI_API_KEY=

# Optional. Pi model in "provider:modelId" format, e.g. anthropic:claude-sonnet-4-5-20250514.
# Defaults to anthropic:claude-sonnet-4-5-20250514.
PI_MODEL=
