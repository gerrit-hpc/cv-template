# Generated CVs and cover letters — keep them out of version control by default.
# Remove this line if you want to track applications.
applications/

# Editor / OS junk
.obsidian/
.DS_Store
*.swp
*~
.idea/
.vscode/

# Typst build artifacts (the .typ source is tracked, the PDF is generated alongside)
# applications/ is already excluded above; this catches any stray PDFs elsewhere.
*.pdf

# Open CoDesign's old root-level artifacts from before its working folder moved to design/.
/references/
/MEMORY.md

# CoDesign mirrors the whole repo into design/ as its working state.
# Track only the actual design outputs; ignore everything else in there.
design/*
!design/DESIGN.md
!design/ui-design-spec.md
