    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.0",
    "iron-session": "8.0.4",
    "next": "15.5.18",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "25.8.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "10.5.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.14",
    "prisma": "7.8.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
